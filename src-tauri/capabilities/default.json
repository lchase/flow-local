{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the settings and overlay windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "opener:default",
    "global-shortcut:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "log:default"
  ]
}
